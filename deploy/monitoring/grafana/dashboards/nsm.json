    {
      "id": 16,
      "type": "timeseries",
      "title": "Registrations granted and refused",
      "description": "`no_service`: claims that found nothing under their key; `full`, `per_host`: admission limits; `host_mismatch`, `bad_port`: bad advertisements.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (role) (rate(nsm_registrations_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "granted {{role}}",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(nsm_registrations_refused_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "refused {{reason}}",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Removals and re-pairings",
      "description": "`heartbeats_failed`: a two-sided party stopped answering; `no_ping`: a ping-mode party fell silent; `no_replacement`: a client whose service vanished with no spare. Re-pairings are the clients that found one.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (role, reason) (increase(nsm_removals_total{instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{role}} {{reason}}",
          "refId": "A",
          "range": true,
