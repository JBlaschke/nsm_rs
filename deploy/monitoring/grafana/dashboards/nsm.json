{
  "uid": "nsm-broker",
  "title": "NSM broker",
  "description": "What an nsm broker holds and what it has done: parties, registrations, removals, heartbeats, requests and the shared stores. Source: nsm listen --admin-bind, GET /metrics.",
  "tags": [
    "nsm"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "schemaVersion": 39,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Broker",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(nsm_build_info, instance)",
          "refId": "instance"
        },
        "definition": "label_values(nsm_build_info, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Broker restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "expr": "changes(nsm_start_time_seconds{instance=~\"$instance\"}[5m]) > 0",
        "titleFormat": "broker restarted",
        "textFormat": "{{instance}}"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
