# Build outputs (also catches Finder duplicates such as "target 2/")
/target*/

# OS and editor noise
**/.DS_Store
.idea/
.vscode/
*.swp

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.csr
*.crt
*.p12

# Archives and images (never commit build artefacts)
*.tar
*.tar.*
*.log

# Deployment-specific manifests generated per cluster (see deploy/k8s/README.md)
clusterrole.yaml
clusterrolebinding.yaml
role.yaml
rolebinding.yaml
view-events-role.yaml

# Vendored crates must be tracked completely: their .cargo-checksum.json
# lists every file, test certificates and editor settings included, and an
# offline build from a fresh clone fails when one is missing. None of the
# rules above may apply below vendor/.
!vendor/**/.vscode/
!vendor/**/.idea/
!vendor/**/*.pem
!vendor/**/*.key
!vendor/**/*.csr
!vendor/**/*.crt
!vendor/**/*.p12
!vendor/**/*.tar
!vendor/**/*.tar.*
!vendor/**/*.log
!vendor/**/.env
!vendor/**/.env.*
