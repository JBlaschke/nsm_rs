# Copy to .env and adjust. Nothing in the binaries reads this file directly;
# export the variables (e.g. `set -a; . ./.env; set +a`) or pass them via
# your process manager / compose `environment:` block.

# TLS material for the server side (`--tls` on `listen`, `publish`, `claim`).
CERT_PATH=/path/to/cert.pem
KEY_PATH=/path/to/key.pem

# Optional root CA bundle used by clients to verify the broker (PEM).
# When unset the platform trust store is used.
#ROOT_PATH=/path/to/ca.pem

# Logging: trace | debug | info | warn | error   and   auto | always | never
NSM_LOG_LEVEL=info
NSM_LOG_STYLE=auto
