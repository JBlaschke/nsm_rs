# Copy to .env and adjust. Nothing in the binary reads this file directly;
# export the variables (e.g. `set -a; . ./.env; set +a`) or pass them via
# your process manager / compose `environment:` block. Every variable here
# has a command-line flag of the same meaning that takes precedence.

# TLS identity presented when serving TLS (--tls-cert / --tls-key).
CERT_PATH=/path/to/cert.pem
KEY_PATH=/path/to/key.pem

# Root CA bundle used to verify TLS peers (--root-ca). Required whenever a
# TLS peer is dialled, unless --system-roots opts into the platform store.
#ROOT_PATH=/path/to/ca.pem

# Bearer token for the REST control plane (nsm serve --token). Required when
# binding anything other than a loopback address.
#NSM_TOKEN=change-me

# Logging: trace | debug | info | warn | error, or a tracing directive such as
# nsm=debug; and auto | always | never for colour.
NSM_LOG_LEVEL=info
NSM_LOG_STYLE=auto
